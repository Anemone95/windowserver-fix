<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.wenyuan.ws-shield-fix</string>
	<!-- Live-patches SkyLight show_shield_windows in each new WindowServer
	     (shield-window leak, see ~/Work/windowserver.md §5.1).
	     Blocks on kqueue NOTE_EXIT for the running WindowServer between patches. -->
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/ws-shield-fix/ws-shield-watch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/ws-shield-fix.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/ws-shield-fix.log</string>
</dict>
</plist>
